SUPABASE_URL=https://zjomxuolpmgwkdxyxasz.supabase.co
SUPABASE_PROJECT_REF=zjomxuolpmgwkdxyxasz
SUPABASE_REST_URL=https://zjomxuolpmgwkdxyxasz.supabase.co/rest/v1/

# --- clés nouveau format ---
# publique par nature : c'est elle qui sera embarquee dans l'app
SUPABASE_PUBLISHABLE_KEY=<A_COMPLETER>
# contourne toutes les regles d'acces : serveur / outillage uniquement
SUPABASE_SECRET_KEY=<A_COMPLETER>

# --- clés format JWT hérité (compatibilité) ---
SUPABASE_ANON_JWT=<A_COMPLETER>
SUPABASE_SERVICE_ROLE_JWT=<A_COMPLETER>

# --- Personal Access Token (API de management : DDL) ---
# supabase.com/dashboard/account/tokens  -> Generate new token
# Indispensable pour pousser le schema sans Node ni psql.
SUPABASE_ACCESS_TOKEN=<A_COMPLETER>
