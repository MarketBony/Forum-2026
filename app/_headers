# Cloudflare Pages — en-têtes de réponse

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# La coquille ne doit jamais être servie périmée : c'est elle qui porte
# la version de l'application. Le service worker gère le hors ligne.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
