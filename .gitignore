# Secrets — ne doit JAMAIS partir vers GitHub / Cloudflare
.env
.env.*
# La négation doit rester APRÈS le motif qu'elle rattrape, sinon
# .env.example redevient ignoré.
!.env.example

# Exports de la soirée : ils contiennent les noms des garages et leurs
# codes d'accès. Ils restent sur le poste, jamais dans le dépôt.
exports/

# Donnees du generateur de badges. Meme regle que exports/ : elles
# portent les codes d'acces de tout le monde, elles restent sur le poste.
badges/participants.json
badges/marques.json
badges/sauvegarde-*.json
# Traces de lancement et d'export : locales a la machine.
badges/_etat.json
badges/_export-etat.json
badges/_impression/
badges/_journal-lancement.txt
# Le raccourci porte un chemin absolu : il se recree avec
# scripts/creer-raccourci.ps1, il ne se versionne pas.
*.lnk

# Divers
node_modules/
dist/
.DS_Store
Thumbs.db
